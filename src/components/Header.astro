---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<header class="custom-header">
	<div class="loader" id="loader">
		<div class="loader-counter">
			<span id="counter">0</span><span class="accent">%</span>
		</div>
		<div class="loader-bar">
			<div class="loader-bar-fill" id="loaderBar"></div>
		</div>
		<div class="loader-text">Loading Experience</div>
	</div>

	<div class="scroll-progress" id="scrollProgress"></div>

	<div class="cursor-dot" id="cursorDot"></div>
	<div class="cursor-ring" id="cursorRing"></div>

	<nav class="nav" id="nav">
		<a href="#home" class="nav-logo">
			<div class="nav-logo-mark">HS</div>
			<span
				>Himanshu saxena<span style="color: var(--accent);"
				></span></span
			>
		</a>
		<ul class="nav-links">
			<li><a href="#about">About</a></li>
			<li><a href="#skills">Skills</a></li>
			<li><a href="#services">Services</a></li>
			<li><a href="#portfolio">Work</a></li>
			<li><a href="#experience">Experience</a></li>
			<li><a href="#contact">Contact</a></li>
		</ul>
		<div class="nav-actions">
			<button
				class="theme-toggle"
				id="themeToggle"
				aria-label="Toggle theme"
			>
				<svg
					id="themeIcon"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
				>
					<path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"
					></path>
				</svg>
			</button>
			<a href="#contact" class="nav-cta">
				<span class="dot"></span>
				<span>Let's Talk</span>
			</a>
			<button class="menu-btn" id="menuBtn" aria-label="Menu">
				<svg
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
				>
					<path d="M3 12h18M3 6h18M3 18h18"></path>
				</svg>
			</button>
		</div>
	</nav>
</header>
<div class="mobile-menu" id="mobileMenu">
	<div class="mobile-menu-header">
		<a href="#home" class="nav-logo">
			<div class="nav-logo-mark">H</div>
			<span>Himanshu Saxena</span>
		</a>
		<button class="mobile-menu-close" id="closeMenu" aria-label="Close">
			<svg
				width="20"
				height="20"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
			>
				<path d="M18 6L6 18M6 6l12 12"></path>
			</svg>
		</button>
	</div>
	<ul class="mobile-menu-links">
		<li>
			<a href="#about" class="mobile-link"
				><span>About</span><span class="num">01</span></a>
		</li>
		<li>
			<a href="#skills" class="mobile-link"
				><span>Skills</span><span class="num">02</span></a>
		</li>
		<li>
			<a href="#services" class="mobile-link"
				><span>Services</span><span class="num">03</span></a>
		</li>
		<li>
			<a href="#portfolio" class="mobile-link"
				><span>Work</span><span class="num">04</span></a>
		</li>
		<li>
			<a href="#experience" class="mobile-link"
				><span>Experience</span><span class="num">05</span></a>
		</li>
		<li>
			<a href="#contact" class="mobile-link"
				><span>Contact</span><span class="num">06</span></a>
		</li>
	</ul>
</div>
