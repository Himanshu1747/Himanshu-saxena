				</div>

				<h1 class="hero-title">
					<span class="line"
						><span class="line-inner">Frontend</span></span
					>
					<span class="line"
						><span class="line-inner"
							><span class="italic">developer</span> &</span
						></span
					>
					<span class="line"
						><span class="line-inner"
							>digital <span class="outline">craftsman</span
							></span
						></span
