						<a href="#portfolio" class="btn-magnetic btn-primary-m">
							<span>View Selected Work</span>
							<span class="arrow">→</span>
						</a>
						<a href="#contact" class="btn-magnetic btn-ghost-m">
							<span>Start a Project</span>
						</a>
					</div>
				</div>
			</div>

			<div class="hero-scroll">
				<span>Scroll</span>
				<div class="hero-scroll-line"></div>
			</div>
		</section>

		<section class="marquee-section" style="padding: 2rem 0;">
			<div class="marquee">
